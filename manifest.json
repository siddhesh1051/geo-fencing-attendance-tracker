{
  "manifest_version": 3,
  "name": "Razor Attendance Tracker",
  "version": "1.1",
  "description": "Automatically tracks your office attendance using location detection.",
  "permissions": [
    "geolocation",
    "storage",
    "notifications",
    "alarms",
    "offscreen",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}